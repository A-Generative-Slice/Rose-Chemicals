# Backend Production Environment Variables
# Copy to backend/.env.production and update with your actual values

# Database Configuration - Use MongoDB Atlas for production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rose-chemicals?retryWrites=true&w=majority

# JWT Configuration - MUST change in production
JWT_SECRET=change_to_a_very_strong_random_secret_in_production_12345678901234567890
JWT_EXPIRE=7d

# Server Configuration
NODE_ENV=production
PORT=5000

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_for_production
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_for_production

# Admin Configuration
ADMIN_EMAIL=admin@rosechemicals.com
ADMIN_PASSWORD=change_this_password_in_production

# AWS S3 Configuration (Recommended for production)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_PATH=./uploads

# Email Configuration
EMAIL_FROM=noreply@rosechemicals.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# CSV Scheduler - Enable for production
ENABLE_CSV_JOBS=true
